# ---- TM1 / Planning Analytics connection ----
# Base REST URL of the TM1 database.
#  - v11 on-prem single instance: https://tm1host:8010
#  - v11 via admin/tm1 rest port : https://tm1host:12354
#  - v12 / PA as a Service       : https://<region>.planninganalytics.saas.ibm.com/api/<TENANT>/v0/tm1/<DATABASE>
TM1_BASE_URL=https://localhost:8010

# Authentication
#  - basic : native TM1 security (username + password)
#  - cam   : IBM Cognos Access Manager (username + password + namespace)
#  - apikey: cloud / v12 API key (username is forced to "apikey", put the key in TM1_PASSWORD)
TM1_AUTH_MODE=basic
TM1_USER=admin
TM1_PASSWORD=
TM1_CAM_NAMESPACE=

# Accept self-signed certificates (common on TM1 dev servers). Dev only.
TM1_SSL_REJECT_UNAUTHORIZED=false

# Per-request timeout (ms)
TM1_TIMEOUT_MS=60000

# ---- MCP server ----
# readonly (default, safe) | readwrite (enables model-building / write tools)
MCP_MODE=readonly

# HTTP transport (only used by `npm run start:http`)
MCP_HTTP_PORT=3900
# Optional bearer token required by the HTTP transport. Leave empty to disable auth (loopback only).
MCP_HTTP_TOKEN=
